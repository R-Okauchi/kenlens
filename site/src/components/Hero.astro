---
interface Props {
  lang: 'ja' | 'en';
}

const { lang } = Astro.props;

const STORE_URL = 'https://chromewebstore.google.com/detail/naccpnjaahllelmoijpcepnpkpamabec';

// 日本語見出しは文節単位の span (inline-block) で折り返し位置を制御する
const headlinePhrases =
  lang === 'ja'
    ? ['researchmapに、', '被引用数・OA・DOIを表示']
    : ['Citations, OA & DOI', 'on researchmap'];

const t =
  lang === 'ja'
    ? {
        eyebrow: '研レンズ — KenLens',
        sub: '論文ごとのバッジ、プロフィールのサマリー、未登録の論文を見つける整備レポート。無料・オープンソースのChrome拡張です。',
        cta: 'Chromeに追加',
        ctaSub: 'GitHub',
        panelTitle: '論文',
        papers: [
          {
            title: '都市河川流域における降雨流出特性の解析',
            meta: '土木学会論文集 79(2)　2024年3月',
            badges: 'rich',
          },
          {
            title: '地方都市における歴史的橋梁の保存に関する一考察',
            meta: '○○大学紀要 12　2018年3月',
            badges: 'hint',
          },
          {
            title: '河川構造物の維持管理に関する調査報告',
            meta: '調査報告書　2015年',
            badges: 'silent',
          },
        ],
        hintLabel: 'DOI候補',
      }
    : {
        eyebrow: '研レンズ — KenLens',
        sub: 'Per-paper badges, a profile summary, and a maintenance report that finds papers missing from researchmap. A free, open-source Chrome extension.',
        cta: 'Add to Chrome',
        ctaSub: 'GitHub',
        panelTitle: 'Published papers',
        papers: [
          {
            title: 'Rainfall-runoff characteristics in urban river basins',
            meta: 'Journal of JSCE 79(2)　Mar 2024',
            badges: 'rich',
          },
          {
            title: 'On preserving historic bridges in regional cities',
            meta: 'University Bulletin 12　Mar 2018',
            badges: 'hint',
          },
          {
            title: 'A survey report on river structure maintenance',
            meta: 'Survey report　2015',
            badges: 'silent',
          },
        ],
        hintLabel: 'DOI found',
      };
---

<section class="hero">
  <div class="container hero-grid">
    <div class="copy">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 class="headline">
        {headlinePhrases.map((ph) => <span class="ph">{ph}</span>)}
      </h1>
      <p class="sub">{t.sub}</p>
      <div class="cta-row">
        <a class="cta" href={STORE_URL} target="_blank" rel="noopener noreferrer">{t.cta}</a>
        <a
          class="cta-sub"
          href="https://github.com/R-Okauchi/kenlens"
          target="_blank"
          rel="noopener noreferrer">{t.ctaSub} ↗</a
        >
      </div>
    </div>

    <!-- researchmap (Bootstrap 3) パネルの実寸風モック。ホストページは常にライトテーマ -->
    <figure class="mock" aria-label="researchmap page with KenLens badges (mock)">
      <div class="rm-panel">
        <div class="rm-panel-heading">
          {t.panelTitle}
          <span class="rm-count">3</span>
        </div>
        {
          t.papers.map((p) => (
            <div class="rm-item">
              <p class="rm-title">{p.title}</p>
              <p class="rm-meta">{p.meta}</p>
              <div class="kl-badges">
                <span class="kl-glyph" aria-hidden="true">
                  <svg width="11" height="11" viewBox="0 0 12 12">
                    <circle cx="5" cy="5" r="3.4" fill="none" stroke="#98a2b3" stroke-width="1.5" />
                    <line x1="7.8" y1="7.8" x2="10.6" y2="10.6" stroke="#98a2b3" stroke-width="1.6" stroke-linecap="round" />
                  </svg>
                </span>
                {p.badges === 'rich' && (
                  <>
                    <span class="kl-pill kl-cite">❝ 27</span>
                    <span class="kl-pill kl-oa">OA</span>
                    <span class="kl-pill kl-doi">DOI</span>
                  </>
                )}
                {p.badges === 'hint' && <span class="kl-pill kl-hint">✎ {t.hintLabel}</span>}
              </div>
            </div>
          ))
        }
      </div>
    </figure>
  </div>
</section>

<style>
  .hero {
    border-bottom: 1px solid var(--border);
    padding: 72px 0 64px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr);
    gap: 56px;
    align-items: center;
  }

  .copy {
    text-align: left;
  }

  .eyebrow {
    margin: 0 0 14px;
    font-size: 14px;
    font-weight: 700;
    color: var(--brand);
    letter-spacing: 0.03em;
  }

  .headline {
    font-size: 40px;
    line-height: 1.35;
    letter-spacing: 0.01em;
    margin: 0 0 16px;
  }

  /* 文節単位でしか折り返さない */
  .ph {
    display: inline-block;
  }

  .sub {
    font-size: 16px;
    line-height: 1.9;
    color: var(--ink-soft);
    margin: 0 0 28px;
    max-width: 480px;
  }

  .cta-row {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
  }

  .cta {
    display: inline-block;
    background: var(--gradient);
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    padding: 13px 30px;
    border-radius: 10px;
    box-shadow: 0 4px 14px rgba(15, 118, 110, 0.25);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .cta:hover {
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(15, 118, 110, 0.3);
  }

  .cta-sub {
    font-size: 14px;
    color: var(--ink-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---- researchmap パネルのモック (固定ライト配色) ---- */
  .mock {
    margin: 0;
  }

  .rm-panel {
    background: #ffffff;
    border: 1px solid #dddddd;
    border-radius: 6px;
    box-shadow: 0 12px 32px rgba(16, 24, 40, 0.1);
    overflow: hidden;
    font-size: 13px;
    text-align: left;
  }

  .rm-panel::before {
    content: '';
    display: block;
    height: 3px;
    background: var(--gradient);
  }

  .rm-panel-heading {
    padding: 9px 14px;
    background: #f5f5f5;
    border-bottom: 1px solid #dddddd;
    color: #333333;
    font-weight: 700;
    font-size: 14px;
  }

  .rm-count {
    display: inline-block;
    background: #777777;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    border-radius: 10px;
    padding: 1px 8px;
    margin-left: 6px;
    vertical-align: 1px;
  }

  .rm-item {
    padding: 12px 14px;
    border-bottom: 1px solid #eeeeee;
  }

  .rm-item:last-child {
    border-bottom: none;
  }

  .rm-title {
    margin: 0 0 2px;
    color: #337ab7;
    font-size: 13.5px;
    line-height: 1.5;
  }

  .rm-meta {
    margin: 0 0 7px;
    color: #777777;
    font-size: 12px;
  }

  .kl-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .kl-glyph {
    display: inline-flex;
    opacity: 0.6;
  }

  .kl-pill {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 1px 9px;
    border-radius: 999px;
    border: 1px solid transparent;
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1.6;
    white-space: nowrap;
  }

  .kl-cite {
    color: #0b5e57;
    background: #e6f4f2;
  }

  .kl-oa {
    color: #15693b;
    background: #e7f6ec;
  }

  .kl-doi {
    color: #3a5276;
    background: #eef2f8;
  }

  .kl-hint {
    color: #5d6b7e;
    background: #f8fafc;
    border: 1px dashed #8a94a4;
  }

  @media (max-width: 860px) {
    .hero {
      padding: 48px 0;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .headline {
      font-size: 28px;
    }
  }
</style>
