---
interface Props {
  lang: 'ja' | 'en';
}

const { lang } = Astro.props;

const t =
  lang === 'ja'
    ? {
        privacy: '通信は閲覧中のresearchmapページの処理に必要な分だけ。閲覧履歴の収集はありません。',
        privacyLink: 'プライバシーポリシー',
        sources: 'データ: researchmap ・ OpenAlex ・ Crossref ・ Unpaywall (各サービスとは提携していません)',
        oss: 'Apache-2.0 で公開',
      }
    : {
        privacy: 'Only the requests needed for the researchmap page you are viewing. No browsing history is collected.',
        privacyLink: 'Privacy policy',
        sources: 'Data: researchmap, OpenAlex, Crossref, Unpaywall (not affiliated with any of them)',
        oss: 'Open source (Apache-2.0)',
      };

// BASE_URL は base 設定時に末尾スラッシュ無し ('/kenlens') になるため必ず正規化する
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const privacyHref = lang === 'ja' ? `${base}privacy/` : `${base}en/privacy/`;
---

<section id="trust" class="strip-wrap">
  <div class="container">
    <p class="strip">
      <span>{t.privacy} <a href={privacyHref}>{t.privacyLink} →</a></span>
      <span>{t.sources}</span>
      <span>
        <a href="https://github.com/R-Okauchi/kenlens" target="_blank" rel="noopener noreferrer">
          {t.oss} ↗
        </a>
      </span>
    </p>
  </div>
</section>

<style>
  .strip-wrap {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface-sunken);
  }

  .strip {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 36px;
    margin: 0;
    padding: 18px 0;
    font-size: 13px;
    line-height: 1.8;
    color: var(--ink-soft);
  }

  a {
    color: var(--ink-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
